<%- include('components/head') %>
<%- include('components/navbar') %>

<main>
    <div class="container py-5">
        <div class="row gy-4">
            <div class="col-md-12"><h1 class="text-center fw-bold mb-4">Contact Me</h1></div>
        </div>
        <div class="row gy-4">
            <div class="col-md-6 mx-auto">
                <div id="thanks" class="alert alert-success d-none" role="alert"><i class="fa-solid fa-circle-check me-2"></i>Thanks for your message!</div>
                <form id="contact-form" class="contact-form p-4">
                    <div class="mb-3"><label class="form-label" for="name">Name</label>
                    <input class="form-control" type="text" id="name" placeholder="John Doe" required></div>
                    <div class="mb-3"><label class="form-label" for="email">Email</label>
                    <input class="form-control" type="email" id="email" placeholder="john.doe@example.com" required></div>
                    <div class="mb-3"><label class="form-label" for="comments">Comments</label>
                    <textarea class="form-control" id="comments" rows="6" required></textarea></div>
                    <div><button class="btn btn-primary btn-brand" type="submit">Submit</button></div>
                </form>
            </div>
        </div>
    </div>
</main>

<script src="/javascripts/contact.js"></script>

<%- include('components/footer') %>
