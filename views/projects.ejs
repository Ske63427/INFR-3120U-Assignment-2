<%- include('components/head') %>
<%- include('components/navbar') %>

<main>
    <div class="container-fluid projects-banner py-4">
        <div class="row gy-4">
            <div class="col-md-12"><h1 class="text-center fw-bold mb-0">My Projects</h1></div>
        </div>
    </div>
    <div class="container py-5">
        <div class="row gy-4">
            <% projects.forEach(function(project) { %>
            <div class="col-md-6 col-lg-3">
                <div class="project-card h-100 bg-white">
                    <img class="img-fluid w-100 d-block" src="<%= project.image %>" alt="<%= project.alt %>">
                    <div class="p-4">
                        <h5 class="fw-bold"><%= project.name %></h5>
                        <p class="mb-0"><%= project.description %></p>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
</main>

<%- include('components/footer') %>